{
  "name": "gatefit",
  "private": true,
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": ">=24.9"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:e2e": "pnpm --filter e2e test:e2e",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "i18n:check": "node packages/i18n/scripts/check-translations.mjs",
    "infra:up": "docker compose --env-file .env -f infra/docker-compose.dev.yml up -d",
    "infra:down": "docker compose --env-file .env -f infra/docker-compose.dev.yml down"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@next/eslint-plugin-next": "16.4.6",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.0.0",
    "globals": "^17.14.0",
    "prettier": "^3.9.10",
    "turbo": "^2.11.10",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.72.2"
  }
}
