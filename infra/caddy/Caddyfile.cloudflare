# Behind a Cloudflare Tunnel (CADDY_CONFIG=Caddyfile.cloudflare). Routes: routes.caddy.
#
# Visitors reach Cloudflare over HTTPS with Cloudflare's certificate; the cloudflared
# container forwards their requests to Caddy over plain HTTP on the Docker network. Caddy
# needs no certificates and the server opens no ports to the internet, so this works on a
# line without a public address (CGNAT). Runbook: infra/staging/README.md.
{
	auto_https off
	servers {
		# cloudflared runs on the Docker network. Only requests from there may name the
		# visitor's address (CF-Connecting-IP) and scheme (X-Forwarded-Proto: https).
		trusted_proxies static private_ranges
		client_ip_headers CF-Connecting-IP
	}
}

http:// {
	import routes.caddy
}
