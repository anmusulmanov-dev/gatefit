# Staging configuration. On the server: /srv/gatefit/.env, created by infra/staging/init-env.sh,
# which fills every CHANGE_ME with a random value. Never commit the real file.

NODE_ENV=production
# Staging is not production: development drivers (console SMS) are allowed. Sign-in codes
# appear in `docker compose logs api`.
APP_ENV=staging
LOG_LEVEL=info

API_PORT=8000
CORS_ORIGINS=
# Hosts: <base>, admin.<base>, <slug>.<base>, <slug>-my.<base>.
APP_BASE_DOMAIN=staging.gatefit.uz
TRUST_PROXY=true
# Where Caddy gets certificates. acme: Let's Encrypt, needs ports 80/443 reachable from the
# internet. internal: Caddy's own CA, for a staging reachable only over Tailscale.
CADDY_TLS_ISSUER=internal

# Public through a Cloudflare Tunnel instead (runbook: "Public through Cloudflare Tunnel"):
# COMPOSE_PROFILES=tunnel
# CADDY_CONFIG=Caddyfile.cloudflare
# CADDY_BIND=127.0.0.1
# The tunnel's token from the Cloudflare dashboard. A secret: never commit or print it.
# CLOUDFLARE_TUNNEL_TOKEN=

JWT_SECRET=CHANGE_ME_JWT
# 32 bytes, base64. Losing it makes stored TOTP secrets unreadable: keep a copy of this file.
DATA_ENCRYPTION_KEY=CHANGE_ME_KEY

SMS_DRIVER=console
RATE_LIMIT_PER_MINUTE=300
AUTH_RATE_LIMIT_PER_MINUTE=20

# PostgreSQL. POSTGRES_USER is the cluster superuser: bootstraps roles only.
POSTGRES_USER=gatefit
POSTGRES_PASSWORD=CHANGE_ME_PG
POSTGRES_DB=gatefit
DB_APP_PASSWORD=CHANGE_ME_APP
DB_MIGRATOR_PASSWORD=CHANGE_ME_MIGRATOR
DATABASE_URL=postgresql://gatefit_app:CHANGE_ME_APP@postgres:5432/gatefit
DATABASE_ADMIN_URL=postgresql://gatefit_migrator:CHANGE_ME_MIGRATOR@postgres:5432/gatefit

REDIS_URL=redis://redis:6379

S3_ENDPOINT=http://minio:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=gatefit
S3_SECRET_KEY=CHANGE_ME_S3
S3_BUCKET=gatefit-staging

# Seed: the demo organization's owner (https://demo.<base>) and the platform operator
# (https://admin.<base>). Read the generated passwords on the server: grep SEED_ .env
SEED_OWNER_PHONE=+998900000001
SEED_OWNER_PASSWORD=CHANGE_ME_OWNER
SEED_PLATFORM_ADMIN_PHONE=+998900000009
SEED_PLATFORM_ADMIN_PASSWORD=CHANGE_ME_OPERATOR
