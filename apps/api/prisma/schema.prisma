// Table and column names are snake_case. Models are added per stage (docs/PROMPTS.md).
//
// Tenancy rules (docs/ADR/0001-multi-tenancy.md):
// - Every business table has organization_id and an RLS policy in a hand-written migration.
// - Children reference parents with (organization_id, id), so a row can never point at
//   another organization's row, even if application code is wrong.
// - audit_logs is created as a partitioned table by hand-written SQL; the model below only
//   describes its columns.

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "cjs"
  // Extensionless imports resolve both under ts-jest and in the compiled CommonJS output.
  importFileExtension = ""
}

datasource db {
  provider = "postgresql"
}

enum OrganizationStatus {
  trial
  active
  blocked

  @@map("organization_status")
}

enum StaffStatus {
  active
  inactive

  @@map("staff_status")
}

model Organization {
  id          String             @id @default(uuid(7)) @db.Uuid
  name        String
  slug        String             @unique
  country     String             @db.Char(2)
  currency    String             @db.Char(3)
  locale      String
  status      OrganizationStatus @default(trial)
  trialEndsAt DateTime?          @map("trial_ends_at") @db.Timestamptz(3)
  // The plan in force now; saas_subscriptions keeps the history.
  saasPlanId  String?            @map("saas_plan_id") @db.Uuid
  createdAt   DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt   DateTime?          @map("deleted_at") @db.Timestamptz(3)

  locations       Location[]
  staff           Staff[]
  staffLocations  StaffLocation[]
  roles           Role[]
  rolePermissions RolePermission[]
  auditLogs       AuditLog[]
  consents        Consent[]
  sessions        Session[]
  otpCodes        OtpCode[]
  saasPlan        SaasPlan?          @relation(fields: [saasPlanId], references: [id])
  subscriptions   SaasSubscription[]

  @@map("organizations")
}

model Location {
  id             String    @id @default(uuid(7)) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  name           String
  address        String?
  // IANA zone, e.g. Asia/Tashkent. Expiry and limits are computed in this zone.
  timezone       String
  workingHours   Json?     @map("working_hours")
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt      DateTime? @map("deleted_at") @db.Timestamptz(3)

  organization   Organization    @relation(fields: [organizationId], references: [id])
  staffLocations StaffLocation[]

  @@unique([organizationId, id])
  @@unique([organizationId, name])
  @@map("locations")
}

// Global identity: one person, one phone, shared by all organizations. It carries no
// credentials: a password and an authenticator belong to a staff record, so one
// organization can never affect sign-in at another (docs/ADR/0003-staff-credentials.md).
model User {
  id        String    @id @default(uuid(7)) @db.Uuid
  // E.164
  phone     String    @unique
  email     String?   @unique
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(3)

  staff    Staff[]
  consents Consent[]
  sessions Session[]

  @@map("users")
}

model Role {
  id             String    @id @default(uuid(7)) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  name           String
  // Standard roles created with the organization; their names are translated in the UI.
  isSystem       Boolean   @default(false) @map("is_system")
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt      DateTime? @map("deleted_at") @db.Timestamptz(3)

  organization Organization     @relation(fields: [organizationId], references: [id])
  permissions  RolePermission[]
  staff        Staff[]

  @@unique([organizationId, id])
  @@unique([organizationId, name])
  @@map("roles")
}

model RolePermission {
  organizationId String   @map("organization_id") @db.Uuid
  roleId         String   @map("role_id") @db.Uuid
  permission     String
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id])
  role         Role         @relation(fields: [organizationId, roleId], references: [organizationId, id])

  @@id([roleId, permission])
  @@index([organizationId, roleId])
  @@map("role_permissions")
}

model Staff {
  id                 String      @id @default(uuid(7)) @db.Uuid
  organizationId     String      @map("organization_id") @db.Uuid
  userId             String      @map("user_id") @db.Uuid
  roleId             String      @map("role_id") @db.Uuid
  position           String?
  firstName          String      @map("first_name")
  lastName           String      @map("last_name")
  // Argon2id. Null until a password is set.
  passwordHash       String?     @map("password_hash")
  // AES-256-GCM. Null while no authenticator is enrolled.
  totpSecret         String?     @map("totp_secret")
  // Set when someone else chose the password: the next sign-in must replace it.
  mustChangePassword Boolean     @default(false) @map("must_change_password")
  status             StaffStatus @default(active)
  createdAt          DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt          DateTime?   @map("deleted_at") @db.Timestamptz(3)

  organization Organization    @relation(fields: [organizationId], references: [id])
  user         User            @relation(fields: [userId], references: [id])
  role         Role            @relation(fields: [organizationId, roleId], references: [organizationId, id])
  locations    StaffLocation[]

  @@unique([organizationId, id])
  @@unique([organizationId, userId])
  @@index([organizationId, roleId])
  @@map("staff")
}

model StaffLocation {
  organizationId String   @map("organization_id") @db.Uuid
  staffId        String   @map("staff_id") @db.Uuid
  locationId     String   @map("location_id") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id])
  staff        Staff        @relation(fields: [organizationId, staffId], references: [organizationId, id])
  location     Location     @relation(fields: [organizationId, locationId], references: [organizationId, id])

  @@id([staffId, locationId])
  @@index([organizationId, locationId])
  @@map("staff_locations")
}

// Append-only and partitioned by month on "at" (the partition key must be part of the
// primary key). The API role may only INSERT and SELECT.
model AuditLog {
  id             String   @default(uuid(7)) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  // users.id of whoever acted; null for system jobs.
  actorId        String?  @map("actor_id") @db.Uuid
  action         String
  entity         String
  entityId       String?  @map("entity_id") @db.Uuid
  before         Json?
  after          Json?
  ip             String?  @db.Inet
  at             DateTime @default(now()) @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id])

  @@id([id, at])
  @@index([organizationId, at])
  @@index([organizationId, entity, entityId])
  @@map("audit_logs")
}

enum SessionAudience {
  staff
  member

  @@map("session_audience")
}

// One row per issued refresh token. Rotation adds a row to the same family and stamps the
// old one; presenting a stamped token again revokes the whole family.
model Session {
  id               String          @id @default(uuid(7)) @db.Uuid
  organizationId   String          @map("organization_id") @db.Uuid
  userId           String          @map("user_id") @db.Uuid
  familyId         String          @map("family_id") @db.Uuid
  audience         SessionAudience
  // SHA-256 of the token; the token itself is never stored.
  refreshTokenHash String          @unique @map("refresh_token_hash")
  userAgent        String?         @map("user_agent")
  ip               String?         @db.Inet
  expiresAt        DateTime        @map("expires_at") @db.Timestamptz(3)
  rotatedAt        DateTime?       @map("rotated_at") @db.Timestamptz(3)
  revokedAt        DateTime?       @map("revoked_at") @db.Timestamptz(3)
  createdAt        DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id])
  user         User         @relation(fields: [userId], references: [id])

  @@index([organizationId, userId])
  @@index([organizationId, familyId])
  @@map("sessions")
}

// One-time SMS sign-in code. Only a keyed hash of the code is stored.
model OtpCode {
  id             String    @id @default(uuid(7)) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  phone          String
  codeHash       String    @map("code_hash")
  attempts       Int       @default(0)
  expiresAt      DateTime  @map("expires_at") @db.Timestamptz(3)
  consumedAt     DateTime? @map("consumed_at") @db.Timestamptz(3)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id])

  @@index([organizationId, phone, createdAt])
  @@map("otp_codes")
}

// Append-only record of an accepted agreement. member_id is added with the members table.
model Consent {
  id             String   @id @default(uuid(7)) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  userId         String?  @map("user_id") @db.Uuid
  type           String
  version        String
  ip             String?  @db.Inet
  at             DateTime @default(now()) @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id])
  user         User?        @relation(fields: [userId], references: [id])

  @@index([organizationId, type])
  @@map("consents")
}

// ---------------------------------------------------------------------------
// Platform (Gatefit itself, not a tenant). These tables are global.
// ---------------------------------------------------------------------------

enum SaasBillingPeriod {
  monthly
  yearly

  @@map("saas_billing_period")
}

enum PlatformAdminStatus {
  active
  inactive

  @@map("platform_admin_status")
}

// A tariff. Prices and limits live here, never in code (docs/TZ.md section 12).
model SaasPlan {
  id         String   @id @default(uuid(7)) @db.Uuid
  // Stable identifier used by code and seed: start, standard, pro.
  key        String   @unique
  name       String
  // { activeMembersPerLocation: number | null }
  limits     Json
  // Module keys from packages/shared/src/modules.ts
  modules    Json
  // Per location per month, in the smallest unit of the currency.
  priceMinor BigInt   @map("price_minor")
  currency   String   @db.Char(3)
  isActive   Boolean  @default(true) @map("is_active")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  organizations Organization[]
  subscriptions SaasSubscription[]

  @@map("saas_plans")
}

// History of the plans an organization has been on. The row without ends_at is current.
model SaasSubscription {
  id             String            @id @default(uuid(7)) @db.Uuid
  organizationId String            @map("organization_id") @db.Uuid
  saasPlanId     String            @map("saas_plan_id") @db.Uuid
  billingPeriod  SaasBillingPeriod @map("billing_period")
  startsAt       DateTime          @map("starts_at") @db.Timestamptz(3)
  endsAt         DateTime?         @map("ends_at") @db.Timestamptz(3)
  createdAt      DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id])
  plan         SaasPlan     @relation(fields: [saasPlanId], references: [id])

  @@index([organizationId, startsAt])
  @@map("saas_subscriptions")
}

// Gatefit's own operators. Deliberately separate from users: a platform identity shares
// nothing with any tenant identity. The API role has no access to this table at all.
model PlatformAdmin {
  id           String              @id @default(uuid(7)) @db.Uuid
  phone        String              @unique
  name         String
  passwordHash String              @map("password_hash")
  totpSecret   String?             @map("totp_secret")
  status       PlatformAdminStatus @default(active)
  createdAt    DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime            @updatedAt @map("updated_at") @db.Timestamptz(3)

  sessions PlatformSession[]

  @@map("platform_admins")
}

model PlatformSession {
  id        String    @id @default(uuid(7)) @db.Uuid
  adminId   String    @map("admin_id") @db.Uuid
  // SHA-256 of the session token; the token itself is never stored.
  tokenHash String    @unique @map("token_hash")
  userAgent String?   @map("user_agent")
  ip        String?   @db.Inet
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  admin PlatformAdmin @relation(fields: [adminId], references: [id])

  @@index([adminId])
  @@map("platform_sessions")
}
