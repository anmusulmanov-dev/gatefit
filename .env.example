# Copy to .env and adjust. Development defaults only: never reuse these values in production.

NODE_ENV=development
LOG_LEVEL=debug

# API
API_PORT=8000
# Comma-separated list of origins allowed to call the API from a browser.
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
# Organizations live at <slug>.<APP_BASE_DOMAIN>. In development: http://demo.localhost:3000
APP_BASE_DOMAIN=localhost
# API description at /api/docs: on unless NODE_ENV or APP_ENV is production. SWAGGER_ENABLED=true|false overrides.
# true when the API sits behind a proxy (the Next dev proxy, Caddy): trust X-Forwarded-* headers.
TRUST_PROXY=true

# Secrets. Generate real ones for any shared environment:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"   JWT_SECRET
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"      DATA_ENCRYPTION_KEY
JWT_SECRET=dev-only-jwt-secret-change-me-0123456789abcdef
# 32 bytes, base64. Encrypts TOTP secrets and keys the hash of SMS codes.
DATA_ENCRYPTION_KEY=ZGV2LW9ubHktZGF0YS1lbmNyeXB0aW9uLWtleS0zMmI=

# SMS. "console" prints messages to the terminal and is refused when NODE_ENV=production.
SMS_DRIVER=console
# SMS_DRIVER=eskiz: the Eskiz account; every message text must be approved there first.
ESKIZ_EMAIL=
ESKIZ_PASSWORD=
ESKIZ_FROM=4546

# Requests per minute from one IP: all endpoints, and sign-in endpoints separately.
RATE_LIMIT_PER_MINUTE=300
AUTH_RATE_LIMIT_PER_MINUTE=20

# PostgreSQL (infra/docker-compose.dev.yml)
# POSTGRES_USER is the cluster superuser: used only to bootstrap roles, never by the app.
POSTGRES_USER=gatefit
POSTGRES_PASSWORD=gatefit
POSTGRES_DB=gatefit
POSTGRES_PORT=5432
DB_APP_PASSWORD=gatefit_app
DB_MIGRATOR_PASSWORD=gatefit_migrator
# The API connects as gatefit_app, which is always subject to row-level security.
DATABASE_URL=postgresql://gatefit_app:gatefit_app@localhost:5432/gatefit
# Migrations, seed and the platform module connect as gatefit_migrator (bypasses RLS).
# The API reads it too, but only inside modules/platform.
DATABASE_ADMIN_URL=postgresql://gatefit_migrator:gatefit_migrator@localhost:5432/gatefit
# Integration tests use a separate database that is wiped on every run.
TEST_DATABASE_URL=postgresql://gatefit_app:gatefit_app@localhost:5432/gatefit_test
TEST_DATABASE_ADMIN_URL=postgresql://gatefit_migrator:gatefit_migrator@localhost:5432/gatefit_test

# Seed (pnpm --filter api seed): the demo organization's owner. Sign in at http://demo.localhost:3000
SEED_OWNER_PHONE=+998900000001
SEED_OWNER_PASSWORD=demo-owner-password
# The platform operator. Sign in at http://admin.localhost:3000
SEED_PLATFORM_ADMIN_PHONE=+998900000009
SEED_PLATFORM_ADMIN_PASSWORD=demo-operator-password
# false: the platform only (SaaS plans, the operator), no demo organization. Production.
SEED_DEMO=true
# Load test (infra/load/README.md): a staff account without TOTP that may verify entries,
# read payments and the daily report, e.g. a manager of the demo organization.
LOAD_STAFF_PHONE=
LOAD_STAFF_PASSWORD=

# Redis
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# S3-compatible storage (MinIO in dev). STORAGE_DRIVER=memory keeps files in memory
# (machines without MinIO; refused in production).
STORAGE_DRIVER=s3
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=gatefit
S3_SECRET_KEY=gatefit-secret
S3_BUCKET=gatefit-dev

# Frontends: where the Next.js servers reach the API.
API_INTERNAL_URL=http://localhost:8000

# Production backups (infra/docker-compose.prod.yml, docs/RUNBOOK.md): an S3 bucket at
# another provider or region than the server. WAL-G archive under BACKUP_S3_PREFIX,
# logical dumps under dumps/ in the same bucket. Unused in development.
BACKUP_S3_ENDPOINT=
BACKUP_S3_REGION=
BACKUP_S3_BUCKET=
BACKUP_S3_PREFIX=
BACKUP_S3_ACCESS_KEY=
BACKUP_S3_SECRET_KEY=
