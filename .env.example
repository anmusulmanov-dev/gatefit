# Copy to .env and adjust. Development defaults only: never reuse these values in production.

NODE_ENV=development
LOG_LEVEL=debug

# API
API_PORT=8000
# Comma-separated list of origins allowed to call the API from a browser.
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# PostgreSQL (infra/docker-compose.dev.yml)
POSTGRES_USER=gatefit
POSTGRES_PASSWORD=gatefit
POSTGRES_DB=gatefit
POSTGRES_PORT=5432
DATABASE_URL=postgresql://gatefit:gatefit@localhost:5432/gatefit

# Redis
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# S3-compatible storage (MinIO in dev)
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=gatefit
S3_SECRET_KEY=gatefit-secret
S3_BUCKET=gatefit-dev

# Frontends
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
